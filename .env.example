IDP_APP_NAME=Vietnamese Invoice IDP
IDP_DATABASE_URL=sqlite:///./data/idp_invoice.db
IDP_PIPELINE_MODE=heuristic
IDP_VLM_PROVIDER=mock
IDP_VLM_MODEL=gpt-4o-mini
IDP_OPENAI_API_KEY=
IDP_GEMINI_API_KEY=
IDP_USE_PADDLE=false
IDP_USE_VIETOCR=false
# PaddleOCR GPU (only used when IDP_USE_PADDLE=true)
IDP_OCR_STRICT=true
IDP_PADDLE_DEVICE=auto
IDP_PADDLE_LANG=vi
IDP_PADDLE_OCR_VERSION=PP-OCRv6
IDP_PADDLE_MODEL_SIZE=medium
IDP_PADDLE_REC_BATCH_SIZE=16
IDP_PADDLE_DET_LIMIT_SIDE_LEN=960
IDP_PADDLE_GPU_MEMORY_FRACTION=0.5
IDP_MAX_UPLOAD_BYTES=12000000
IDP_MAX_IMAGE_DIMENSION=3000
IDP_MAX_DECODED_PIXELS=40000000
IDP_REVIEW_CONFIDENCE_THRESHOLD=0.85
IDP_CORS_ORIGINS=*
