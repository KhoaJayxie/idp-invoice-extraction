IDP_APP_NAME=Vietnamese Invoice IDP
IDP_DATABASE_URL=sqlite:///./data/idp_invoice.db
IDP_PIPELINE_MODE=heuristic
IDP_VLM_PROVIDER=mock
IDP_VLM_MODEL=gpt-4o-mini
IDP_OPENAI_API_KEY=
IDP_GEMINI_API_KEY=
IDP_USE_PADDLE=false
IDP_USE_VIETOCR=false
# Hybrid (P4) local VLM fallback — requires requirements-vlm.txt + model preload:
#   pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cu128
#   pip install -r requirements-vlm.txt
#   huggingface-cli download Qwen/Qwen2.5-VL-3B-Instruct
# (IDP_VLM_PROVIDER được đặt ở đầu file; đổi thành 'local' để bật VLM cục bộ)
IDP_VLM_LOCAL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# Trên Windows, paddle (cuDNN 9.9) và torch (cuDNN 9.10) không chung process được.
# Tạo venv riêng cho VLM worker (xem requirements-vlm.txt) rồi trỏ vào đây:
IDP_VLM_WORKER_PYTHON=C:\Users\khoas\idp-invoice-extraction-main\.venv-vlm\Scripts\python.exe
IDP_VLM_MAX_PIXELS=1003520
IDP_VLM_MAX_NEW_TOKENS=768
IDP_VLM_KEEP_LOADED=true
IDP_HYBRID_CRITICAL_FIELDS=seller,total_cost,timestamp
IDP_HYBRID_MIN_KIE_CONFIDENCE=0.75
# PaddleOCR GPU (only used when IDP_USE_PADDLE=true)
IDP_OCR_STRICT=true
IDP_PADDLE_DEVICE=auto
IDP_PADDLE_LANG=vi
IDP_PADDLE_OCR_VERSION=PP-OCRv6
IDP_PADDLE_MODEL_SIZE=medium
IDP_PADDLE_REC_BATCH_SIZE=16
IDP_PADDLE_DET_LIMIT_SIDE_LEN=960
IDP_PADDLE_GPU_MEMORY_FRACTION=0.5
IDP_MAX_UPLOAD_BYTES=12000000
IDP_MAX_IMAGE_DIMENSION=3000
IDP_MAX_DECODED_PIXELS=40000000
IDP_REVIEW_CONFIDENCE_THRESHOLD=0.85
IDP_CORS_ORIGINS=*
